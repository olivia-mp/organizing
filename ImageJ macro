// Batch Single-Spheroid Brightfield Area Measurement (10x)
// Calibrated at 1.24 um/pixel and outputs Area in um^2

inputDir = getDirectory("Choose the folder containing your exported .tif images");
list = getFileList(inputDir);

run("Set Measurements...", "area perimeter circularity display redirect=None decimal=3");
run("Clear Results");
setBatchMode(true);

for (i = 0; i < list.length; i++) {
    if (endsWith(list[i], ".tif") || endsWith(list[i], ".tiff")) {
        open(inputDir + list[i]);
        
        // apply 10x calibration (1.24 um/pixel)
        run("Set Scale...", "distance=1 known=1.24 pixel=1 unit=um");
        
        // convert to 8-bit grayscale and smooth texture noise
        // IF YOU SEE LOTS OF ZEROS ON .csv FILE - increase sigma=x 
        run("8-bit");
        run("Gaussian Blur...", "sigma=2.5");
        
        // auto-threshold darker spheroid against bright background
        setAutoThreshold("Default");
        setOption("BlackBackground", false);
        run("Convert to Mask");
        run("Fill Holes");
        
        // only measure objects larger than 3,000 um^2 (ignore debris)
        // IF YOU SEE LOTS OF ZEROS ON .csv FILE - decrease size=x
        // IF YOU SEE ANYTHING OTHER THAN 1 FOR COUNT ON SINGLE SPHEROID - INCREASE size=x
        run("Analyze Particles...", "size=10000-Infinity circularity=0.20-1.00 show=Nothing display summarize");
        
        close();
    }
}

setBatchMode(false);
saveAs("Results", inputDir + "Spheroid_Area.csv");
print("all done! results saved to " + inputDir + "Spheroid_Area.csv");